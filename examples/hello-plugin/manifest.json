{
  "id": "hello-plugin",
  "name": "你好，插件",
  "version": "1.0.0",
  "description": "演示插件：读写存储、发送通知、订阅消息事件。安装后可在设置 → 高级 → 插件中心启用。",
  "author": "AstrBot Desktop Team",
  "entry": "index.js",
  "minAppVersion": "1.0.0",
  "permissions": ["storage", "notifications", "events", "trayMenu"],
  "trayMenu": [
    { "id": "greet", "label": "问好" },
    { "id": "toggle-notify", "label": "开关消息通知" }
  ],
  "subscriptions": ["message:received"],
  "settings": [
    {
      "key": "greeting",
      "kind": "text",
      "label": "问候语",
      "description": "每次桌面端启动时展示的问候语",
      "defaultValue": "你好，我是插件示例~"
    },
    {
      "key": "notifyOnMessage",
      "kind": "boolean",
      "label": "收到消息时通知",
      "description": "是否在收到消息时发送系统通知",
      "defaultValue": false
    },
    {
      "key": "notifyTimes",
      "kind": "number",
      "label": "每日通知上限",
      "min": 0,
      "max": 20,
      "defaultValue": 3
    },
    {
      "key": "preferredLanguage",
      "kind": "select",
      "label": "偏好语言",
      "options": [
        { "label": "中文", "value": "zh" },
        { "label": "English", "value": "en" },
        { "label": "日本語", "value": "ja" }
      ],
      "defaultValue": "zh"
    }
  ]
}
